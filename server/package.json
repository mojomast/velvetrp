{
  "name": "velvet-mvp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"for (const name of ['currentSchema.sql','campaignDmSchema.sql','recallSchema.sql','contextInspectionProvenanceSchema.sql','npcKnowledgeSchema.sql']) require('node:fs').copyFileSync('src/repo/db/'+name,'dist/repo/db/'+name)\"",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:quick": "vitest run --config vitest.quick.config.ts",
    "test:serial": "vitest run --no-file-parallelism"
  },
  "dependencies": {
    "@velvet/contracts": "0.1.0",
    "better-sqlite3": "^13.0.2",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
