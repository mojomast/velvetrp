# Complete user-facing server runtime and client-development example.
# Velvet does not load this file automatically; export it before startup.
HOST=127.0.0.1
PORT=8787
VELVET_DATA_DIR=
VELVET_SSE_HEARTBEAT_MS=15000
VELVET_API_URL=http://localhost:8787

# Recommended OpenRouter bootstrap overrides. Persisted provider settings win.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_TITLE=Velvet

# Legacy-compatible fallbacks. A defined OPENROUTER value, even blank, wins;
# unset/comment the corresponding OPENROUTER assignment to use a fallback.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Optional capabilities are disabled unless set to the exact value true.
FEATURE_VOICE=false
FEATURE_IMAGES=false
FEATURE_RPG_CAMPAIGN=false
FEATURE_RPG_MECHANICS=false
FEATURE_RPG_COMBAT=false
FEATURE_RPG_STUDIO=false
FEATURE_REMOTE_AUTHENTICATION=false
