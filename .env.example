# Complete user-facing server runtime and client-development example.
# Velvet does not load this file automatically; export it before startup.
HOST=127.0.0.1
PORT=8787
VELVET_DATA_DIR=
VELVET_SSE_HEARTBEAT_MS=15000
VELVET_API_URL=http://localhost:8787
# Optional comma-separated extra Vite dev-server hostnames for reverse-proxy or tailnet access.
VELVET_ALLOWED_HOSTS=

# Recommended OpenRouter bootstrap overrides. Persisted provider settings win.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_TITLE=Velvet
# Optional client identification for local inference gateways such as RouteTok.
OPENROUTER_USER_AGENT=

# Optional RouteTok probe settings used by `npm run probe:routetok` only.
ROUTETOK_BASE_URL=http://127.0.0.1:8787/v1
PROXY_API_KEY=

# Legacy-compatible fallbacks. A defined OPENROUTER value, even blank, wins;
# unset/comment the corresponding OPENROUTER assignment to use a fallback.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Optional capabilities are disabled unless set to the exact value true.
FEATURE_VOICE=false
# Optional campaign narration via an operator-configured OmniVoice Studio.
# FEATURE_VOICE remains discovery-only; the voice integration uses this explicit opt-in.
# See docs/omnivoice-support-plan.md for approved voice JSON and external deployment.
VELVET_VOICE_ENABLED=false
OMNIVOICE_BASE_URL=http://127.0.0.1:13900
VELVET_VOICE_DEFINITIONS=[]
VELVET_VOICE_TIMEOUT_MS=300000
VELVET_VOICE_ALLOWED_ORIGINS=
# Optional image generation via an operator-configured self-hosted service.
# FEATURE_IMAGES remains discovery-only; the image integration uses this explicit opt-in.
# See docs/image-generation-integration.md.
VELVET_IMAGES_ENABLED=false
VELVET_IMAGES_BASE_URL=
VELVET_IMAGES_TOKEN=
VELVET_IMAGES_MODEL=
VELVET_IMAGES_TIMEOUT_MS=120000
VELVET_IMAGES_MAX_BYTES=8388608
FEATURE_IMAGES=false
FEATURE_RPG_CAMPAIGN=false
FEATURE_RPG_MECHANICS=false
FEATURE_RPG_COMBAT=false
FEATURE_RPG_STUDIO=false
FEATURE_REMOTE_AUTHENTICATION=false

# Optional System One (Jev) structured-decision profile. Disabled by default and
# never required: every decision lane falls back to deterministic behavior.
# See docs/jev-integration.md and docs/provider-configuration.md.
FEATURE_SYSTEM_ONE=false
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
TYPESAFE_MODEL=jev-latest
TYPESAFE_API_KEY=
